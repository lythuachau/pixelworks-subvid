# Optional for local dev: without this, link import uses yt-dlp on PATH.
# Required on the local Node backend for production link import.
# Self-hosted Cobalt Ã¢â‚¬â€ public api.cobalt.tools is bot-protected (not for apps).
# Docs: https://github.com/imputnet/cobalt/blob/main/docs/run-an-instance.md
# COBALT_API_URL=https://cobalt.example.com

# Optional: if your Cobalt instance requires API-key auth
# COBALT_API_KEY=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee

# REQUIRED for link import: HMAC secret for short-lived /api/media/proxy
# download tokens. Must be at least 32 characters; without it /api/media/*
# returns 503 (no insecure fallback secret). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MEDIA_PROXY_SECRET=change-me-to-a-long-random-string

# Local dev / tests only: allow a private-IP translate endpoint (127.0.0.1 etc).
# NEVER set this in production - it re-opens the SSRF hole in /api/translate/*.
# ALLOW_PRIVATE_TRANSLATE_ENDPOINT=1

# Optional: max download size in bytes (default 160_000_000 ≈ 160 MB)
# MEDIA_MAX_BYTES=160000000

# Groq Whisper server-side audio-to-text (keep the key on the server)
# GROQ_API_KEY=your-groq-key
# GROQ_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
# GROQ_TRANSCRIBE_MODELS=whisper-large-v3,whisper-large-v3-turbo

# Gemini (Google AI Studio) for contextual subtitle translation
# GEMINI_API_KEY=your-ai-studio-key
# GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
# Custom OpenAI / Anthropic-compatible translation gateway
# CUSTOM_TRANSLATE_BASE_URL=https://api.freemodel.dev
# CUSTOM_TRANSLATE_API_KEY=your-key
# CUSTOM_TRANSLATE_MODEL=gpt-5.6-sol
# Optional ordered fallback list selected by the UI
# CUSTOM_TRANSLATE_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# CUSTOM_TRANSLATE_PROTOCOL=openai
# Optional reliability controls (defaults shown)
# CUSTOM_TRANSLATE_MAX_RETRIES=2
# CUSTOM_TRANSLATE_REQUEST_TIMEOUT_MS=30000
# CUSTOM_TRANSLATE_MAX_ELAPSED_MS=120000

# Aiven PostgreSQL and the AES-256-GCM data key used for dynamic API config.
# Provision both outside Git/command history. The service launcher unwraps the
# data key with Windows DPAPI before starting Node.
# SUBVID_DATABASE_URL=postgresql://...
# SUBVID_CONFIG_DATA_KEY=base64-encoded-32-byte-key

# Protected API administration. Store only a PBKDF2 hash, never a password.
# SUBVID_API_ADMIN_USER=admin
# SUBVID_API_ADMIN_PASSWORD_HASH=pbkdf2-sha256$...
# SUBVID_API_ADMIN_SESSION_SECRET=long-random-session-secret
