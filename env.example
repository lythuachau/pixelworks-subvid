# Copy only the values needed by your deployment to the external service file.
# Never commit the populated production file.

# Aiven PostgreSQL. Keep credentials outside Git.
SUBVID_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/defaultdb?sslmode=require

# Protected API administration.
SUBVID_API_ADMIN_USER=admin
SUBVID_API_ADMIN_PASSWORD_HASH=pbkdf2-sha256$REPLACE_WITH_GENERATED_HASH
SUBVID_API_ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Required for signed media proxy URLs.
MEDIA_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MEDIA_MAX_BYTES=160000000

# Optional server-side speech provider.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_TRANSCRIBE_MODELS=whisper-large-v3,whisper-large-v3-turbo

# Optional self-hosted Cobalt. Local yt-dlp is used when this is blank.
COBALT_API_URL=
COBALT_API_KEY=

# Translation provider keys can be entered through the protected UI and are
# encrypted in PostgreSQL. These variables are optional bootstrap fallbacks.
GEMINI_API_KEY=
GEMINI_TRANSLATE_MODEL=gemini-2.5-flash
CUSTOM_TRANSLATE_BASE_URL=
CUSTOM_TRANSLATE_API_KEY=
CUSTOM_TRANSLATE_MODEL=
CUSTOM_TRANSLATE_MODELS=
CUSTOM_TRANSLATE_PROTOCOL=openai
CUSTOM_TRANSLATE_MAX_RETRIES=2
CUSTOM_TRANSLATE_REQUEST_TIMEOUT_MS=30000
CUSTOM_TRANSLATE_MAX_ELAPSED_MS=120000

# Development only. Never enable in production.
# ALLOW_PRIVATE_TRANSLATE_ENDPOINT=1
